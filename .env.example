# ========================================================
# INDEPENDENT ADVOCATE WEBSITE - ENVIRONMENT CONFIGURATION
# ========================================================
# All values must be supplied by the administrator/advocate.
# Never commit real credentials to version control.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MongoDB Connection String (Required for persistent storage)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/advocate_db?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/advocate_db"

# Admin Session Secret (Required: Min 32 characters random string)
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-in-production"

# Initial Admin Bootstrap Credentials (Used only by scripts/seed-admin.mjs)
INITIAL_ADMIN_EMAIL="admin@advocatechamber.local"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongInitialPassword123!"

# Email Delivery Configuration (Optional - for enquiry notifications)
# Provider choices: RESEND or SMTP
EMAIL_PROVIDER="none" # Options: none | resend | smtp
RESEND_API_KEY=""
NOTIFICATION_EMAIL_TO=""

# SMTP Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@advocatechamber.local"

# ========================================================
# PROFESSIONAL CONDUCT & FEATURE FLAGS
# Bar Council of India (BCI) Rule 36 Compliance Safeguards
# Keep disabled (false) until verified by the advocate.
# ========================================================

# Enable public consultation enquiry form (Default: false)
# Requires review of data collection, disclaimers, and professional conduct rules.
ENABLE_PUBLIC_ENQUIRIES="false"

# Enable WhatsApp click-to-chat (Default: false)
# Requires verified advocate number and neutral prefilled template review.
ENABLE_WHATSAPP_CHAT="false"
WHATSAPP_PHONE_NUMBER="" # International format without '+' or spaces, e.g., 919810000000

# Rate Limiting Thresholds (Requests per 15-minute window)
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_ENQUIRY_MAX="3"

# Data Retention Policy (Days to retain enquiry data before automated deletion)
ENQUIRY_RETENTION_DAYS="90"
